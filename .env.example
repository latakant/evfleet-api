# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://evfleet:password@localhost:5435/evfleet_db?schema=public

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6382

# ── App ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── JWT (use long random strings in production) ──────────────────
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh

# ── MSG91 (OTP) ───────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Cloudinary (KYC uploads) ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay (future payments) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── FCM (push notifications) ─────────────────────────────────────
FCM_SERVER_KEY=
